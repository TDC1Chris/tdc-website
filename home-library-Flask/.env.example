# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# Database
DATABASE_URI=sqlite:///example.db

# Weather API
# National Weather Service API requires User-Agent header
# No API key needed - it's a free public API
USER_AGENT=Flask-Library-App/1.0 (contact@example.com)
